{
  "name": "petrinet-io",
  "version": "0.2.0",
  "description": "Petri net modeling & simulation viewer",
  "main": "dist/petrinet-io.umd.js",
  "exports": {
    ".": {
      "import": "./dist/petrinet-io.umd.js",
      "require": "./dist/petrinet-io.umd.js"
    }
  },
  "browser": "dist/petrinet-io.umd.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "webpack --mode production --config webpack.config.js",
    "start": "npm run dev",
    "static": "npm run build",
    "deploy": "wrangler deploy",
    "build:lib": "webpack --mode production --config webpack.lib.config.js",
    "preview": "wrangler dev",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "diagram-js": "^15.2.4",
    "diagram-js-direct-editing": "^3.2.0",
    "diagram-js-grid": "^1.1.0",
    "jspdf": "^4.2.1",
    "petrinet-io": "^0.2.0",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1",
    "svg2pdf.js": "^2.6.0",
    "tiny-svg": "^4.1.3"
  },
  "overrides": {
    "petrinet-io": {
      "jspdf": "^4.2.1"
    }
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "bpmn-font": "^0.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "babel-jest": "^29.7.0",
    "bpmn-font": "^0.12.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "wrangler": "^4.85.0"
  }
}
